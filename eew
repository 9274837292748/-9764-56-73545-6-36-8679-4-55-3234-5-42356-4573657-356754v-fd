--// Logging

local function Debug(...)
    if CONFIG.Debug then
        print("[Moonlight]", ...)
    end
end

local function Warn(...)
    warn("[Moonlight]", ...)
end

--// Action decoding

local ActionCache = {}

local function UnfilterAction(input)
    assert(
        type(input) == "string",
        "Expected action string"
    )

    if ActionCache[input] then
        return ActionCache[input]
    end

    local encoded = FilterMappings.ActionMappings[input]

    assert(
        encoded,
        string.format('Unknown action "%s"', input)
    )

    local output = {}

    for _, code in utf8.codes(encoded) do
        output[#output + 1] = utf8.char(
            code + FilterMappings.Offset
        )
    end

    local decoded = table.concat(output)

    ActionCache[input] = decoded

    return decoded
end

--// Character utilities

local function GetBackpack()
    return speaker:FindFirstChildOfClass("Backpack")
end

local function GetCharacter()
    return speaker.Character
end

local function GetHumanoid()
    local character = GetCharacter()

    if not character then
        return nil
    end

    return character:FindFirstChildOfClass("Humanoid")
end

--// F3X detection

local function GetRemote(tool)
    if not tool or not tool.Parent then
        return nil
    end

    local bindable = tool:FindFirstChildOfClass(
        "BindableFunction"
    )

    if not bindable then
        return nil
    end

    return bindable:FindFirstChildOfClass(
        "RemoteFunction"
    )
end

local function IsF3XTool(tool)
    if not tool or not tool:IsA("Tool") then
        return false
    end

    if tool.Name ~= "Building Tools"
        and tool.Name ~= "F3X" then
        return false
    end

    return GetRemote(tool) ~= nil
end

local function GetAllTools()
    local result = {}
    local seen = {}

    local containers = {
        GetCharacter(),
        GetBackpack()
    }

    for _, container in ipairs(containers) do
        if container then
            for _, child in ipairs(container:GetChildren()) do
                if IsF3XTool(child) and not seen[child] then
                    seen[child] = true
                    result[#result + 1] = child
                end
            end
        end
    end

    return result
end

--// Equipment

local function EquipTool(tool)
    if not tool or not tool.Parent then
        return false, "Tool unavailable"
    end

    local character = GetCharacter()
    local backpack = GetBackpack()
    local humanoid = GetHumanoid()

    if not character or not backpack or not humanoid then
        return false, "Character, Backpack or Humanoid missing"
    end

    if tool.Parent == character then
        return true
    end

    if tool.Parent ~= backpack then
        return false, "Tool not in Backpack or Character"
    end

    local success, err = pcall(function()
        humanoid:EquipTool(tool)
    end)

    if not success then
        return false, tostring(err)
    end

    local started = os.clock()

    while tool.Parent ~= character do
        if os.clock() - started >= CONFIG.EquipTimeout then
            break
        end

        if not tool.Parent then
            break
        end

        task.wait()
    end

    if tool.Parent == character then
        return true
    end

    return false, "F3X equip timed out"
end

local function UnequipTool(tool)
    if not tool then
        return false
    end

    local backpack = GetBackpack()
    local character = GetCharacter()

    if not backpack or not character then
        return false
    end

    if tool.Parent == backpack then
        return true
    end

    if tool.Parent ~= character then
        return false
    end

    local success = pcall(function()
        tool.Parent = backpack
    end)

    return success and tool.Parent == backpack
end

--// Dispatcher

local Dispatcher = {}
Dispatcher.__index = Dispatcher

function Dispatcher.new()
    local self = setmetatable({}, Dispatcher)

    self.Running = true

    self.Tools = {}
    self.ToolData = {}

    self.Queue = {}
    self.QueueHead = 1
    self.QueueTail = 0

    self.ActiveRequests = 0
    self.SelectedTool = nil
    self.NextToolIndex = 1

    self.Stats = {
        Submitted = 0,
        Completed = 0,
        Failed = 0,
        Rejected = 0,
        TotalLatency = 0,
    }

    self:RefreshTools()
    self:Start()

    return self
end

function Dispatcher:QueueLength()
    return math.max(
        0,
        self.QueueTail - self.QueueHead + 1
    )
end

function Dispatcher:RefreshTools()
    local detected = GetAllTools()
    local previousCount = #self.Tools

    local valid = {}

    for _, tool in ipairs(detected) do
        valid[tool] = true

        if not self.ToolData[tool] then
            self.ToolData[tool] = {
                Tool = tool,
                Active = 0,
                Completed = 0,
                Failed = 0,
            }
        end
    end

    for tool, data in pairs(self.ToolData) do
        if not valid[tool] and data.Active == 0 then
            self.ToolData[tool] = nil
        end
    end

    self.Tools = detected

    if self.SelectedTool
        and not valid[self.SelectedTool]
        and self.ActiveRequests == 0 then
        self.SelectedTool = nil
    end

    if self.NextToolIndex > #self.Tools then
        self.NextToolIndex = 1
    end

    if previousCount ~= #self.Tools then
        Debug("Detected F3X tools:", #self.Tools)
    end
end

function Dispatcher:GetToolCount()
    return #self.Tools
end

function Dispatcher:GetToolList()
    local result = {}

    for _, tool in ipairs(self.Tools) do
        result[#result + 1] = tool
    end

    return result
end

function Dispatcher:ChooseTool()
    if self.ActiveRequests > 0 then
        local selected = self.SelectedTool

        if selected
            and IsF3XTool(selected)
            and self.ToolData[selected]
            and self.ToolData[selected].Active
                < CONFIG.MaxConcurrentPerTool then
            return selected
        end

        return nil
    end

    local count = #self.Tools

    if count == 0 then
        return nil
    end

    for offset = 0, count - 1 do
        local index = (
            (self.NextToolIndex + offset - 1) % count
        ) + 1

        local tool = self.Tools[index]

        if IsF3XTool(tool) then
            self.NextToolIndex = (index % count) + 1

            return tool
        end
    end

    return nil
end

function Dispatcher:Submit(action, args)
    assert(type(action) == "string", "Expected action string")
    assert(type(args) == "table", "Expected argument table")

    UnfilterAction(action)

    if not self.Running then
        error("Moonlight dispatcher stopped", 2)
    end

    if self:QueueLength() >= CONFIG.MaxQueueSize then
        self.Stats.Rejected += 1
        error("Moonlight queue full", 2)
    end

    local request = {
        Action = action,
        Args = args,

        Done = false,
        Success = false,

        Results = nil,
        Error = nil,

        SubmittedAt = os.clock()
    }

    self.QueueTail += 1
    self.Queue[self.QueueTail] = request

    self.Stats.Submitted += 1

    return request
end

function Dispatcher:Pop()
    if self.QueueHead > self.QueueTail then
        return nil
    end

    local request = self.Queue[self.QueueHead]

    self.Queue[self.QueueHead] = nil
    self.QueueHead += 1

    if self.QueueHead > self.QueueTail then
        self.QueueHead = 1
        self.QueueTail = 0
    end

    return request
end

function Dispatcher:FailRequest(request, message)
    if request.Done then
        return
    end

    request.Error = tostring(message)
    request.Success = false
    request.Done = true

    self.Stats.Failed += 1
end

function Dispatcher:Execute(tool, request)
    local data = self.ToolData[tool]

    if not data then
        self:FailRequest(request, "Tool data unavailable")
        return
    end

    self.SelectedTool = tool

    data.Active += 1
    self.ActiveRequests += 1

    task.spawn(function()
        local started = os.clock()

        local result = table.pack(
            pcall(function()
                if not self.Running then
                    error("Dispatcher stopped")
                end

                local equipped, equipError = EquipTool(tool)

                if not equipped then
                    error(equipError)
                end

                local remote = GetRemote(tool)

                if not remote then
                    error("F3X RemoteFunction missing")
                end

                return remote:InvokeServer(
                    UnfilterAction(request.Action),
                    table.unpack(
                        request.Args,
                        1,
                        request.Args.n
                    )
                )
            end)
        )

        local latency = os.clock() - started

        if not request.Done then
            request.Success = result[1]

            if result[1] then
                request.Results = table.pack(
                    table.unpack(result, 2, result.n)
                )

                self.Stats.Completed += 1
                data.Completed += 1
            else
                request.Error = tostring(result[2])

                self.Stats.Failed += 1
                data.Failed += 1

                Warn(
                    request.Action,
                    "failed:",
                    request.Error
                )
            end

            self.Stats.TotalLatency += latency
            request.Done = true
        end

        data.Active -= 1
        self.ActiveRequests -= 1

        if self.ActiveRequests == 0 then
            self.SelectedTool = nil
        end
    end)
end

function Dispatcher:Dispatch()
    if not self.Running then
        return
    end

    if self:QueueLength() == 0 then
        return
    end

    if self.ActiveRequests >= CONFIG.MaxConcurrentGlobal then
        return
    end

    if #self.Tools == 0 then
        return
    end

    local tool = self:ChooseTool()

    if not tool then
        return
    end

    local request = self:Pop()

    if request then
        self:Execute(tool, request)
    end
end

function Dispatcher:Start()
    task.spawn(function()
        local lastRefresh = 0

        while self.Running do
            local now = os.clock()

            if now - lastRefresh >= CONFIG.RefreshInterval then
                self:RefreshTools()
                lastRefresh = now
            end

            self:Dispatch()

            task.wait(CONFIG.SchedulerInterval)
        end
    end)

    Debug("Dispatcher started")
end

function Dispatcher:Wait(request)
    while not request.Done do
        task.wait()
    end

    if not request.Success then
        error(
            request.Error or "F3X request failed",
            2
        )
    end

    if request.Results then
        return table.unpack(
            request.Results,
            1,
            request.Results.n
        )
    end
end

function Dispatcher:GetStats()
    local finished = self.Stats.Completed
        + self.Stats.Failed

    local average = 0

    if finished > 0 then
        average = self.Stats.TotalLatency / finished
    end

    local tools = {}

    for _, tool in ipairs(self.Tools) do
        local data = self.ToolData[tool]

        if data then
            tools[#tools + 1] = {
                Name = tool.Name,
                Active = data.Active,
                Completed = data.Completed,
                Failed = data.Failed,
                Equipped = tool.Parent == GetCharacter()
            }
        end
    end

    return {
        Tools = #self.Tools,
        ToolDetails = tools,

        Queued = self:QueueLength(),
        Active = self.ActiveRequests,

        Submitted = self.Stats.Submitted,
        Completed = self.Stats.Completed,
        Failed = self.Stats.Failed,
        Rejected = self.Stats.Rejected,

        AverageLatency = average,
    }
end

function Dispatcher:Shutdown()
    if not self.Running then
        return
    end

    self.Running = false

    while self:QueueLength() > 0 do
        local request = self:Pop()

        if request then
            self:FailRequest(
                request,
                "Moonlight dispatcher shut down"
            )
        end
    end

    Debug("Dispatcher stopped")
end

--// F3X class

local F3X = {}
F3X.__index = F3X

function F3X.new(dispatcher)
    assert(dispatcher, "Dispatcher required")

    return setmetatable({
        Dispatcher = dispatcher,
        Tool = dispatcher.Tools[1]
    }, F3X)
end

function F3X:IsActive()
    return self.Dispatcher.Running
        and self.Dispatcher:GetToolCount() > 0
end

--// FIXED EQUIP FUNCTION

function F3X:Equip(state)
    -- Default to true when omitted.
    if state == nil then
        state = true
    end

    assert(
        type(state) == "boolean",
        "Expected boolean"
    )

    self.Dispatcher:RefreshTools()

    local tool = self.Tool

    if not IsF3XTool(tool) then
        tool = self.Dispatcher.Tools[1]
    end

    if not tool then
        return false
    end

    self.Tool = tool

    if state then
        local success, err = EquipTool(tool)

        if not success then
            Warn("Equip failed:", err)
        end

        return success
    end

    if self.Dispatcher.ActiveRequests > 0 then
        return false
    end

    return UnequipTool(tool)
end

--// API calls

function F3X:CallAPI(sync, action, ...)
    assert(
        type(sync) == "boolean",
        "Expected sync to be boolean"
    )

    assert(
        type(action) == "string",
        "Expected action to be string"
    )

    self.Dispatcher:RefreshTools()

    assert(
        self:IsActive(),
        "F3X is inactive"
    )

    local args = table.pack(...)

    local dispatcher = self.Dispatcher

    if sync then
        local request = dispatcher:Submit(action, args)
        return dispatcher:Wait(request)
    end

    return task.spawn(function()
        local request = dispatcher:Submit(action, args)
        dispatcher:Wait(request)
    end)
end

function F3X:CallAPISync(action, ...)
    return self:CallAPI(true, action, ...)
end

function F3X:CallAPIAsync(action, ...)
    return self:CallAPI(false, action, ...)
end

--// Original helper methods

function F3X:Weld(p1, p2)
    assert(typeof(p1) == "Instance", "Expected Instance")
    assert(typeof(p2) == "Instance", "Expected Instance")

    assert(p1:IsA("BasePart"), "Expected BasePart")
    assert(p2:IsA("BasePart"), "Expected BasePart")

    if (p1.Locked and not p2.Locked)
        or (not p1.Locked and not p2.Locked) then

        return self:CallAPIAsync(
            "CreateWelds",
            {p2},
            p1
        )

    elseif not p1.Locked and p2.Locked then

        return self:CallAPIAsync(
            "CreateWelds",
            {p1},
            p2
        )

    else
        error("Cannot weld two locked parts")
    end
end

function F3X:DestroyInstances(instances)
    assert(type(instances) == "table", "Expected table")

    -- Original behaviour preserved.
    return self:CallAPIAsync(
        "UndoRemove",
        instances
    )
end

function F3X:DestroyInstance(instance)
    assert(
        typeof(instance) == "Instance",
        "Expected Instance"
    )

    return self:CallAPIAsync(
        "UndoRemove",
        {instance}
    )
end

function F3X:SetProperties(instance, properties)
    assert(
        typeof(instance) == "Instance",
        "Expected Instance"
    )

    assert(
        instance:IsA("BasePart"),
        "Expected BasePart"
    )

    assert(
        type(properties) == "table",
        "Expected table"
    )

    local surfaces = {}

    for key, value in pairs(properties) do
        surfaces[tostring(key) .. "\0."] = value
    end

    return self:CallAPIAsync(
        "SyncSurface",
        {
            {
                Part = instance,
                Surfaces = surfaces
            }
        }
    )
end

--// Additional helpers

function F3X:RemoveInstances(instances)
    assert(type(instances) == "table", "Expected table")

    return self:CallAPIAsync(
        "Remove",
        instances
    )
end

function F3X:RemoveInstance(instance)
    assert(
        typeof(instance) == "Instance",
        "Expected Instance"
    )

    return self:RemoveInstances({instance})
end

function F3X:GetStats()
    return self.Dispatcher:GetStats()
end

function F3X:GetToolCount()
    return self.Dispatcher:GetToolCount()
end

function F3X:GetTools()
    return self.Dispatcher:GetToolList()
end

--// Moonlight class

local Moonlight = {}
Moonlight.__index = Moonlight

function Moonlight.new()
    local self = setmetatable({}, Moonlight)

    self.Dispatcher = Dispatcher.new()
    self.F3X = F3X.new(self.Dispatcher)

    self.Version = "Multi-F3X Fixed 2.1"

    return self
end

function Moonlight:GetF3X()
    return self.F3X
end

function Moonlight:GetStats()
    return self.Dispatcher:GetStats()
end

function Moonlight:GetToolCount()
    return self.Dispatcher:GetToolCount()
end

function Moonlight:GetTools()
    return self.Dispatcher:GetToolList()
end

function Moonlight:RefreshTools()
    self.Dispatcher:RefreshTools()
    self.F3X.Tool = self.Dispatcher.Tools[1]
end

function Moonlight:Shutdown()
    if self.Dispatcher then
        self.Dispatcher:Shutdown()
    end
end

--// Initialize

local instance = Moonlight.new()

ENV.Moonlight = instance

Debug(
    "Moonlight",
    instance.Version,
    "initialized"
)

Debug(
    "Detected F3X tools:",
    instance:GetToolCount()
)

return instance
