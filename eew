
--[[
    Moonlight Multi-F3X
    Fixed Version 2.1

    - Fixes F3X:Equip() expected boolean
    - Supports F3X:Equip(), Equip(true), Equip(false)
    - Detects multiple F3X tools
    - Round-robin tool distribution
    - FIFO request scheduling
    - Automatic equipment handling
    - Preserves original Moonlight methods
    - Preserves asynchronous thread returns
    - Handles script re-execution
    - Tracks request statistics

    NOTE:
    Default concurrency is 1 to prevent equipment
    conflicts and preserve operation ordering.
]]

--// Configuration

local CONFIG = {
    Debug = true,

    MaxConcurrentGlobal = 1,
    MaxConcurrentPerTool = 1,

    MaxQueueSize = 1000,

    RefreshInterval = 1,
    SchedulerInterval = 0.01,

    EquipTimeout = 2,

    AllowParallel = false,
}

if not CONFIG.AllowParallel then
    CONFIG.MaxConcurrentGlobal = 1
end

--// Environment

local ENV = (getgenv and getgenv()) or _G

_G.MoonlightDebug = CONFIG.Debug

