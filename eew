--// ACTION DECODING

local ActionCache = {}

local function UnfilterAction(input)
    assert(
        type(input) == "string",
        "Expected action string"
    )

    if ActionCache[input] then
        return ActionCache[input]
    end

    local encoded = FilterMappings.ActionMappings[input]

    assert(
        encoded,
        "Unknown F3X action: " .. tostring(input)
    )

    local output = {}

    for _, code in utf8.codes(encoded) do
        output[#output + 1] = utf8.char(
            code + FilterMappings.Offset
        )
    end

    local decoded = table.concat(output)

    ActionCache[input] = decoded

    return decoded
end

--// CHARACTER UTILITIES

local function GetCharacter()
    return speaker.Character
end

local function GetBackpack()
    return speaker:FindFirstChildOfClass("Backpack")
end

--// TOOL UTILITIES

local function GetRemote(tool)
    if not tool or not tool.Parent then
        return nil
    end

    local bindable = tool:FindFirstChildOfClass(
        "BindableFunction"
    )

    if not bindable then
        return nil
    end

    return bindable:FindFirstChildOfClass(
        "RemoteFunction"
    )
end

local function IsF3X(tool)
    if not tool or not tool:IsA("Tool") then
        return false
    end

    if tool.Name ~= "Building Tools"
        and tool.Name ~= "F3X" then
        return false
    end

    return GetRemote(tool) ~= nil
end

--// MULTI EQUIPMENT

local function EquipMultiple(tools)
    local character = GetCharacter()
    local backpack = GetBackpack()

    if not character or not backpack then
        return false
    end

    local equipped = 0

    -- Direct parenting avoids calling Humanoid:EquipTool,
    -- which normally unequips other tools.

    for _, tool in ipairs(tools) do
        if tool.Parent == character then
            equipped += 1

        elseif tool.Parent == backpack then
            local success, err = pcall(function()
                tool.Parent = character
            end)

            if success and tool.Parent == character then
                equipped += 1
            else
                Warn(
                    "Could not equip",
                    tool.Name,
                    err or "Parent change rejected"
                )
            end
        end
    end

    Debug(
        "Equipment attempt:",
        equipped,
        "/",
        #tools
    )

    return equipped == #tools
end

local function UnequipMultiple(tools)
    local character = GetCharacter()
    local backpack = GetBackpack()

    if not character or not backpack then
        return false
    end

    for _, tool in ipairs(tools) do
        if tool.Parent == character then
            pcall(function()
                tool.Parent = backpack
            end)
        end
    end

    return true
end

--// DISPATCHER

local Dispatcher = {}
Dispatcher.__index = Dispatcher

function Dispatcher.new()
    local self = setmetatable({}, Dispatcher)

    self.Running = true

    self.Tools = {}
    self.ToolData = {}

    self.Queue = {}
    self.QueueHead = 1
    self.QueueTail = 0

    self.NextToolIndex = 1

    self.ActiveRequests = 0

    self.Stats = {
        Submitted = 0,
        Completed = 0,
        Failed = 0,
        Rejected = 0,
        TotalLatency = 0,
    }

    self:RefreshTools()

    if CONFIG.AutoEquip then
        self:EquipAll()
    end

    self:Start()

    return self
end

--// TOOL DISCOVERY

function Dispatcher:RefreshTools()
    local character = GetCharacter()
    local backpack = GetBackpack()

    local found = {}
    local seen = {}

    -- Preserve the existing tool order.
    -- This prevents tools from changing dispatcher
    -- positions during ordinary refreshes.

    for _, tool in ipairs(self.Tools) do
        if IsF3X(tool)
            and (
                tool.Parent == character
                or tool.Parent == backpack
            ) then

            found[#found + 1] = tool
            seen[tool] = true
        end
    end

    local containers = {
        character,
        backpack
    }

    for _, container in ipairs(containers) do
        if container then
            for _, tool in ipairs(container:GetChildren()) do
                if IsF3X(tool) and not seen[tool] then
                    seen[tool] = true

                    found[#found + 1] = tool
                end
            end
        end
    end

    local previousCount = #self.Tools

    for _, tool in ipairs(found) do
        if not self.ToolData[tool] then
            self.ToolData[tool] = {
                Tool = tool,
                Remote = GetRemote(tool),

                Active = 0,
                Completed = 0,
                Failed = 0,

                -- Prevents repeated automatic equipping.
                EquipAttempted = false,
            }
        else
            self.ToolData[tool].Remote = GetRemote(tool)
        end
    end

    local valid = {}

    for _, tool in ipairs(found) do
        valid[tool] = true
    end

    for tool, data in pairs(self.ToolData) do
        if not valid[tool] and data.Active == 0 then
            self.ToolData[tool] = nil
        end
    end

    self.Tools = found

    if self.NextToolIndex > #self.Tools then
        self.NextToolIndex = 1
    end

    if previousCount ~= #self.Tools then
        Debug(
            "Detected F3X tools:",
            #self.Tools
        )
    end

    -- Only attempt automatic equipment once per tool.
    -- Do not keep switching tools during refreshes.

    if CONFIG.AutoEquip and CONFIG.MultiEquip then
        local pending = {}

        for _, tool in ipairs(self.Tools) do
            local data = self.ToolData[tool]

            if data and not data.EquipAttempted then
                data.EquipAttempted = true

                if tool.Parent == GetBackpack() then
                    pending[#pending + 1] = tool
                end
            end
        end

        if #pending > 0 then
            EquipMultiple(pending)
        end
    end
end

function Dispatcher:GetToolCount()
    return #self.Tools
end

function Dispatcher:GetTools()
    local result = {}

    for _, tool in ipairs(self.Tools) do
        result[#result + 1] = tool
    end

    return result
end

--// EQUIPMENT CONTROL

function Dispatcher:EquipAll()
    self:RefreshTools()

    local success = EquipMultiple(self.Tools)

    for _, tool in ipairs(self.Tools) do
        local data = self.ToolData[tool]

        if data then
            data.EquipAttempted = true
        end
    end

    return success
end

function Dispatcher:UnequipAll()
    if self.ActiveRequests > 0 then
        return false
    end

    -- Do not immediately re-equip on the next refresh.
    for _, tool in ipairs(self.Tools) do
        local data = self.ToolData[tool]

        if data then
            data.EquipAttempted = true
        end
    end

    return UnequipMultiple(self.Tools)
end

--// QUEUE

function Dispatcher:QueueLength()
    return math.max(
        0,
        self.QueueTail - self.QueueHead + 1
    )
end

function Dispatcher:Submit(action, args)
    assert(type(action) == "string")
    assert(type(args) == "table")

    UnfilterAction(action)

    assert(
        self.Running,
        "Moonlight dispatcher stopped"
    )

    if self:QueueLength() >= CONFIG.MaxQueueSize then
        self.Stats.Rejected += 1
        error("Moonlight queue full", 2)
    end

    local request = {
        Action = action,
        Args = args,

        Done = false,
        Success = false,

        Results = nil,
        Error = nil,

        SubmittedAt = os.clock(),
    }

    self.QueueTail += 1
    self.Queue[self.QueueTail] = request

    self.Stats.Submitted += 1

    return request
end

function Dispatcher:Pop()
    if self.QueueHead > self.QueueTail then
        return nil
    end

    local request = self.Queue[self.QueueHead]

    self.Queue[self.QueueHead] = nil
    self.QueueHead += 1

    if self.QueueHead > self.QueueTail then
        self.QueueHead = 1
        self.QueueTail = 0
    end

    return request
end

--// TOOL SELECTION

function Dispatcher:SelectTool()
    local count = #self.Tools

    if count == 0 then
        return nil
    end

    local character = GetCharacter()

    for offset = 0, count - 1 do
        local index = (
            (self.NextToolIndex + offset - 1) % count
        ) + 1

        local tool = self.Tools[index]
        local data = self.ToolData[tool]

        if data
            and data.Remote
            and data.Remote.Parent
            and tool.Parent == character
            and data.Active < CONFIG.MaxConcurrentPerTool then

            self.NextToolIndex = (index % count) + 1

            return data
        end
    end

    return nil
end

--// REQUEST EXECUTION

function Dispatcher:Execute(data, request)
    data.Active += 1
    self.ActiveRequests += 1

    local started = os.clock()

    task.spawn(function()
        local result = table.pack(
            pcall(function()
                if not self.Running then
                    error("Dispatcher stopped")
                end

                local remote = data.Remote

                if not remote or not remote.Parent then
                    error("F3X RemoteFunction unavailable")
                end

                if data.Tool.Parent ~= GetCharacter() then
                    error("F3X tool is no longer equipped")
                end

                -- No tool switching occurs here.
                return remote:InvokeServer(
                    UnfilterAction(request.Action),
                    table.unpack(
                        request.Args,
                        1,
                        request.Args.n
                    )
                )
            end)
        )

        local latency = os.clock() - started

        if not request.Done then
            request.Success = result[1]

            if result[1] then
                request.Results = table.pack(
                    table.unpack(result, 2, result.n)
                )

                self.Stats.Completed += 1
                data.Completed += 1
            else
                request.Error = tostring(result[2])

                self.Stats.Failed += 1
                data.Failed += 1

                Warn(
                    request.Action,
                    "failed:",
                    request.Error
                )
            end

            self.Stats.TotalLatency += latency

            request.Done = true
        end

        data.Active -= 1
        self.ActiveRequests -= 1
    end)
end

--// DISPATCH LOOP

function Dispatcher:Dispatch()
    if not self.Running then
        return
    end

    local dispatched = 0

    while self:QueueLength() > 0
        and self.ActiveRequests < CONFIG.MaxConcurrentGlobal
        and dispatched < CONFIG.DispatchBatchSize do

        local data = self:SelectTool()

        if not data then
            break
        end

        local request = self:Pop()

        if not request then
            break
        end

        self:Execute(data, request)

        dispatched += 1
    end
end

function Dispatcher:Start()
    task.spawn(function()
        local lastRefresh = os.clock()

        while self.Running do
            local now = os.clock()

            if now - lastRefresh >= CONFIG.RefreshInterval then
                self:RefreshTools()

                lastRefresh = now
            end

            self:Dispatch()

            task.wait(CONFIG.SchedulerInterval)
        end
    end)

    Debug("Multi-tool dispatcher started")
end

--// SYNCHRONOUS WAIT

function Dispatcher:Wait(request)
    while not request.Done do
        task.wait()
    end

    if not request.Success then
        error(
            request.Error or "F3X request failed",
            2
        )
    end

    if request.Results then
        return table.unpack(
            request.Results,
            1,
            request.Results.n
        )
    end
end

--// STATISTICS

function Dispatcher:GetStats()
    local finished =
        self.Stats.Completed + self.Stats.Failed

    local average = 0

    if finished > 0 then
        average = self.Stats.TotalLatency / finished
    end

    local details = {}

    for index, tool in ipairs(self.Tools) do
        local data = self.ToolData[tool]

        if data then
            details[#details + 1] = {
                Index = index,
                Name = tool.Name,

                Equipped = tool.Parent == GetCharacter(),

                Active = data.Active,
                Completed = data.Completed,
                Failed = data.Failed,
            }
        end
    end

    return {
        Tools = #self.Tools,
        ToolDetails = details,

        Active = self.ActiveRequests,
        Queued = self:QueueLength(),

        Submitted = self.Stats.Submitted,
        Completed = self.Stats.Completed,
        Failed = self.Stats.Failed,
        Rejected = self.Stats.Rejected,

        AverageLatency = average,
    }
end

--// SHUTDOWN

function Dispatcher:Shutdown()
    if not self.Running then
        return
    end

    self.Running = false

    while self:QueueLength() > 0 do
        local request = self:Pop()

        if request then
            request.Done = true
            request.Success = false
            request.Error = "Dispatcher stopped"

            self.Stats.Failed += 1
        end
    end

    -- In-flight InvokeServer calls cannot be cancelled.
    Debug("Dispatcher stopped")
end

--// F3X CLASS

local F3X = {}
F3X.__index = F3X

function F3X.new(dispatcher)
    return setmetatable({
        Dispatcher = dispatcher,
        Tool = dispatcher.Tools[1],
    }, F3X)
end

function F3X:IsActive()
    if not self.Dispatcher.Running then
        return false
    end

    local character = GetCharacter()

    for _, tool in ipairs(self.Dispatcher.Tools) do
        if tool.Parent == character and GetRemote(tool) then
            return true
        end
    end

    return false
end

--// EQUIPMENT API

function F3X:Equip(state)
    if state == nil then
        state = true
    end

    assert(
        type(state) == "boolean",
        "Expected boolean"
    )

    if state then
        return self.Dispatcher:EquipAll()
    else
        return self.Dispatcher:UnequipAll()
    end
end

--// REMOTE API

function F3X:CallAPI(sync, action, ...)
    assert(
        type(sync) == "boolean",
        "Expected sync boolean"
    )

    assert(
        type(action) == "string",
        "Expected action string"
    )

    assert(
        self.Dispatcher.Running,
        "Moonlight dispatcher stopped"
    )

    local args = table.pack(...)

    local dispatcher = self.Dispatcher

    if sync then
        local request = dispatcher:Submit(action, args)

        return dispatcher:Wait(request)
    end

    -- Original asynchronous return type:
    -- task.spawn returns a thread.

    return task.spawn(function()
        local request = dispatcher:Submit(action, args)

        dispatcher:Wait(request)
    end)
end

function F3X:CallAPISync(action, ...)
    return self:CallAPI(true, action, ...)
end

function F3X:CallAPIAsync(action, ...)
    return self:CallAPI(false, action, ...)
end

--// ORIGINAL HELPER METHODS

function F3X:Weld(p1, p2)
    assert(typeof(p1) == "Instance")
    assert(typeof(p2) == "Instance")

    assert(p1:IsA("BasePart"))
    assert(p2:IsA("BasePart"))

    if p1.Locked and p2.Locked then
        error("Cannot weld two locked parts")
    end

    if p2.Locked then
        return self:CallAPIAsync(
            "CreateWelds",
            {p1},
            p2
        )
    end

    return self:CallAPIAsync(
        "CreateWelds",
        {p2},
        p1
    )
end

function F3X:DestroyInstances(instances)
    assert(type(instances) == "table")

    -- Original Moonlight behaviour.
    return self:CallAPIAsync(
        "UndoRemove",
        instances
    )
end

function F3X:DestroyInstance(instance)
    assert(typeof(instance) == "Instance")

    return self:CallAPIAsync(
        "UndoRemove",
        {instance}
    )
end

function F3X:SetProperties(instance, properties)
    assert(typeof(instance) == "Instance")
    assert(instance:IsA("BasePart"))
    assert(type(properties) == "table")

    local surfaces = {}

    for key, value in pairs(properties) do
        surfaces[tostring(key) .. "\0."] = value
    end

    return self:CallAPIAsync(
        "SyncSurface",
        {
            {
                Part = instance,
                Surfaces = surfaces
            }
        }
    )
end

--// ADDITIONAL HELPERS

function F3X:RemoveInstances(instances)
    assert(type(instances) == "table")

    return self:CallAPIAsync(
        "Remove",
        instances
    )
end

function F3X:RemoveInstance(instance)
    assert(typeof(instance) == "Instance")

    return self:RemoveInstances({instance})
end

function F3X:GetStats()
    return self.Dispatcher:GetStats()
end

function F3X:GetTools()
    return self.Dispatcher:GetTools()
end

function F3X:GetToolCount()
    return self.Dispatcher:GetToolCount()
end

--// MOONLIGHT CLASS

local Moonlight = {}
Moonlight.__index = Moonlight

function Moonlight.new()
    local self = setmetatable({}, Moonlight)

    self.Dispatcher = Dispatcher.new()
    self.F3X = F3X.new(self.Dispatcher)

    self.Version = "Multi-F3X 3.0"

    return self
end

function Moonlight:GetF3X()
    return self.F3X
end

function Moonlight:GetStats()
    return self.Dispatcher:GetStats()
end

function Moonlight:GetTools()
    return self.Dispatcher:GetTools()
end

function Moonlight:GetToolCount()
    return self.Dispatcher:GetToolCount()
end

function Moonlight:RefreshTools()
    self.Dispatcher:RefreshTools()
    self.F3X.Tool = self.Dispatcher.Tools[1]
end

function Moonlight:EquipAll()
    return self.Dispatcher:EquipAll()
end

function Moonlight:UnequipAll()
    return self.Dispatcher:UnequipAll()
end

function Moonlight:Shutdown()
    if self.Dispatcher then
        self.Dispatcher:Shutdown()
    end
end

--// INITIALIZATION

local instance = Moonlight.new()

ENV.Moonlight = instance

Debug(
    "Initialized",
    instance.Version
)

Debug(
    "Detected tools:",
    instance:GetToolCount()
)

return instance
