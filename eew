
--[[
    Moonlight Multi-F3X v3.0
    Persistent Multi-Tool Dispatcher

    Features:
    - Attempts simultaneous F3X equipment
    - No per-request tool switching
    - Persistent RemoteFunction references
    - Concurrent requests
    - Round-robin request distribution
    - FIFO dispatch queue
    - Automatic tool discovery
    - Configurable request limits
    - Original Moonlight API compatibility
    - Safe reload handling
    - Request statistics

    NOTE:
    Requests are dispatched in FIFO order, but concurrent
    requests can complete out of order.

    Server-side rate limits and permissions still apply.
]]

--// CONFIGURATION

local CONFIG = {
    Debug = true,

    -- Attempt to keep multiple F3X tools equipped
    MultiEquip = true,

    -- Equip discovered tools during initialization
    AutoEquip = true,

    -- Maximum simultaneous requests for each tool
    MaxConcurrentPerTool = 4,

    -- Maximum simultaneous requests overall
    MaxConcurrentGlobal = 8,

    -- Maximum queued requests
    MaxQueueSize = 2000,

    -- Scheduler
    SchedulerInterval = 0.01,

    -- Tool discovery
    RefreshInterval = 2,

    -- Requests dispatched per scheduler cycle
    DispatchBatchSize = 16,

    -- Retry failed requests?
    -- Disabled because retrying mutations can duplicate them.
    RetryFailedRequests = false,
}

